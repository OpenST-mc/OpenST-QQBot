{
  "name": "OpenST-QQbot",
  "version": "1.0.0",
  "description": "OpenST QQ Bot - event-driven modular bot platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "audit": "tsc -p tsconfig.scripts.json && node dist-scripts/audit-knowledge-data.js",
    "test:audit": "tsc -p tsconfig.scripts.json && node --test dist-scripts/audit-knowledge-data.test.js dist-scripts/lib/auditCalculations.test.js",
    "test": "tsc -p tsconfig.tests.json && node --test \"dist-tests/tests/unit/**/*.test.js\"",
    "postinstall": "node -e \"const fs=require('fs');const p='node_modules/@xenova/transformers/node_modules/sharp';fs.rmSync(p,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.7.2",
    "csv-parse": "^5.5.6",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "form-data": "^4.0.6",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5",
    "tesseract.js": "^7.0.0",
    "undici": "^8.7.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/form-data": "^2.2.1",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "@types/yauzl": "^3.4.0",
    "typescript": "^5.5.3"
  },
  "private": true,
  "allowScripts": {
    "sharp@0.33.5": true
  }
}
