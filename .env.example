# QQ Bot 凭证
QQ_APP_ID=
QQ_APP_SECRET=

# 群组白名单（支持QQ群号或group_openid，逗号分隔，留空不限制）
# 在目标群内发送 /ping 可查看本群的 group_openid
QQ_GROUP_WHITELIST=
QQ_LEARN_WHITELIST=

# DeepSeek API
DEEPSEEK_API_KEY=

# 上传服务
UPLOAD_PORT=3000
UPLOAD_BASE_URL=http://localhost:3000
UPLOAD_FRONTEND_URL=
# 与 Vercel 的 UPLOAD_SECRET 保持一致，使用至少 32 个随机 bytes
UPLOAD_SECRET=

# 联网搜索（默认 DuckDuckGo，免费无需配置）
# 可选: 自定义 SearXNG 后端 (留空则用 DuckDuckGo)
# SEARCH_CUSTOM_URL=https://searx.example.com
# SEARCH_MAX_RESULTS=5
# SEARCH_AI_SUMMARIZE=true
# /ask 命令是否默认注入联网搜索结果（默认开启，false 关闭后仅数据库无匹配时触发）
# SEARCH_IN_ASK=true
# SEARCH_ENABLED=true

# 上传配置
SUBMISSIONS_AC=<群group_openid>
SUBMISSIONS_REVIEWERS=<审核员openid1>,<审核员openid2>
SUBMISSIONS_GH_TOKEN=<GitHub Token，需 Submissions + website 仓库权限>
SUBMISSIONS_POLL_INTERVAL_S=60
SUBMISSIONS_AT_COUNT=2
